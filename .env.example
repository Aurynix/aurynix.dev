# Live demo links shown as "Live App" on each product card.
# Optional: if unset, the defaults below are used. Read at build time.
PULSE_APP_URL=https://pulse.aurynix.dev
NEXUS_APP_URL=https://nexus.aurynix.dev
APEX_APP_URL=https://aurynix-apex-demo.onrender.com

# ── Email auto-reply (src/app/api/inbound/route.ts) ─────────────────────────
# Server-only secrets: set them in Vercel → Settings → Environment Variables.
# Never commit real values; put local ones in .env.local.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Optional. Must be on a domain verified in Resend.
AUTO_REPLY_FROM=Aurynix <hello@aurynix.dev>
